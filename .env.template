# Shared configuration for NaturalDex.
# Copy this file to .env and fill in your values. Both the backend (backend/src/config/settings.py) and the frontend (frontend/vite.config.js with envDir set to the repo root) read this file.

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Database
# Relative sqlite:/// paths resolve against the backend/ directory, so this
# creates <backend>/Database/naturedex.db
DATABASE_URL=sqlite:///./Database/naturedex.db

# Security
SECRET_KEY=your-secret-key-here-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Cookie used by the authenticated HttpOnly session.
AUTH_COOKIE_NAME=naturaldex_token
# Keep False for local HTTP dev; set True behind HTTPS.
COOKIE_SECURE=false

# NatureDex profile / timezone
# IANA timezone used to determine a user's calendar date if none is stored.
USER_DEFAULT_TIMEZONE=UTC

# Vision pipeline
# "ollama" uses the local home base; "mock" is a deterministic provider for local
# dev/tests when Ollama is not running. There is no cloud fallback.
VISION_PROVIDER=ollama
# Private local directory (backend-relative) storing submitted discovery photos.
UPLOAD_DIR=./Database/uploads
# Maximum uploaded photo size in bytes (default 10 MB).
MAX_PHOTO_BYTES=10485760

# AI Integration (local Ollama on the paired home base)
OLLAMA_BASE_URL=http://localhost:11434
# Must be an installed vision-capable Ollama model.
OLLAMA_MODEL=llama2

# Home-base pairing
PAIRING_CHALLENGE_TTL_MINUTES=10

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# Frontend
# Vite exposes only VITE_-prefixed vars to the browser. The API is same-origin
# (dev proxies /api -> backend); set VITE_API_URL only if that changes.
VITE_API_URL=/api